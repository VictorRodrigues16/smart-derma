# Copie para .env.local e preencha.
DATABASE_URL=postgresql://smartderma:smartderma@localhost:5490/smart_derma
# Texto aleatório com pelo menos 24 caracteres (assina o cookie de sessão).
SESSAO_SEGREDO=
# Chave da API da Anthropic (console.anthropic.com). Fica só no servidor.
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5
# low | medium | high: quanto a IA pensa antes de responder.
IA_ESFORCO=medium
# 1 mostra os atalhos "Entrar como cliente" e "Entrar como loja" na tela de login.
DEMO_ATALHOS=1
# Freios para proteger a chave: análises por pessoa por hora e no total por dia.
LIMITE_ANALISES_HORA=8
LIMITE_ANALISES_DIA=300
